# Ignorar bases de datos SQLite y sus archivos temporales
*.db
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Mantener la carpeta data vacía en el repo
data/*.db
!data/.gitkeep

# Carpeta de copias de seguridad
backups/

# Python cache y herramientas de pruebas/calidad
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Carpeta de comprobantes de pago y archivos PDF generados
comprobantes/
*.pdf

# Artefactos de compilación PyInstaller
build/
dist/
*.spec